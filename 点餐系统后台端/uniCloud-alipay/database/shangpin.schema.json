{
	"bsonType": "object",
	"required": ["name", "fenlei_id", "price"],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": true
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"create_time": {
			"bsonType": "timestamp",
			"description": "创建时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"name": {
			"bsonType": "string",
			"description": "商品名称"
		},
		"fenlei_id": {
			"bsonType": "string",
			"description": "所属分类ID"
		},
		"fenlei_name": {
			"bsonType": "string",
			"description": "所属分类名称"
		},
		"price": {
			"bsonType": "number",
			"description": "售价"
		},
		"original_price": {
			"bsonType": "number",
			"description": "原价"
		},
		"image": {
			"bsonType": "string",
			"description": "商品图片"
		},
		"description": {
			"bsonType": "string",
			"description": "商品描述"
		},
		"unit": {
			"bsonType": "string",
			"description": "计量单位",
			"defaultValue": "份"
		},
		"stock": {
			"bsonType": "number",
			"description": "库存数量，-1表示不限",
			"defaultValue": -1
		},
		"sale_count": {
			"bsonType": "number",
			"description": "已售数量",
			"defaultValue": 0
		},
		"status": {
			"bsonType": "string",
			"description": "商品状态",
			"enum": ["上架", "下架"],
			"defaultValue": "上架"
		},
		"sale_time_start": {
			"bsonType": "string",
			"description": "售卖开始时段，如08:00",
			"defaultValue": ""
		},
		"sale_time_end": {
			"bsonType": "string",
			"description": "售卖结束时段，如22:00",
			"defaultValue": ""
		},
		"sort": {
			"bsonType": "number",
			"description": "排序号",
			"defaultValue": 0
		},
		"tags": {
			"bsonType": "array",
			"description": "商品标签",
			"items": {
				"bsonType": "string"
			}
		}
	}
}
