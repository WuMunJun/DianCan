{
	"bsonType": "object",
	"required": ["zhuohao"],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": true
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"create_time": {
			"bsonType": "timestamp",
			"description": "创建时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"zhuohao": {
			"bsonType": "string",
			"description": "桌号"
		},
		"qrcode": {
			"bsonType": "string",
			"description": "点餐二维码图片地址"
		}
	}
}