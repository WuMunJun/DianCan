.wrap {
  width: 100%;
  min-height: 100vh;
  background-color: #FAFAFA;
}
.wrap__userinfo {
  background-color: white;
  border-radius: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 90%;
  margin: -25rpx auto 0 auto;
  position: relative;
  z-index: 1;
  padding: 20rpx;
}
.wrap__userinfo__left {
  display: flex;
  align-items: center;
}
.wrap__userinfo__left__nickname {
  color: #333333;
  font-weight: bold;
  font-size: 24rpx;
  margin-left: 10rpx;
}
.wrap__userinfo__right {
  background-color: #0A3D28;
  color: white;
  border-radius: 50rpx;
  padding: 10rpx 30rpx;
  font-size: 22rpx;
}
.wrap__menu {
  display: flex;
  align-items: center;
  width: 90%;
  margin: 30rpx auto 0 auto;
  background-color: white;
  border-radius: 18rpx;
  padding: 10rpx 0 30rpx 0;
}
.wrap__menu__box {
  width: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.wrap__menu__box__name {
  font-size: 38rpx;
  color: #333333;
  font-weight: bold;
}
.wrap__menu__box__desc {
  font-size: 24rpx;
  color: #909399;
}
.wrap__menu__group {
  border-left: 1px solid #f4f4f5;
  height: 100rpx;
}
.wrap__pointsmall {
  display: flex;
  background-color: white;
  border-radius: 18rpx;
  width: 90%;
  margin: 30rpx auto;
  align-items: flex-end;
  padding-right: 30rpx;
}
.wrap__pointsmall__mypoint {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 20rpx;
}
.wrap__pointsmall__pointdesc {
  font-size: 24rpx;
  color: #909399;
  margin-bottom: 25rpx;
}
.zhuohao-popup {
  width: 600rpx;
  padding: 40rpx;
  background: #fff;
}
.zhuohao-popup__title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}
.zhuohao-popup__zhuohao {
  font-size: 32rpx;
  text-align: center;
  margin-bottom: 40rpx;
  color: #ff9900;
}
.zhuohao-popup__label {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.zhuohao-popup__people {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 40rpx;
}
.zhuohao-popup__people__item {
  width: 100rpx;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  font-size: 26rpx;
}
.zhuohao-popup__people__item.active {
  border-color: #ff9900;
  background: #fff5e6;
  color: #ff9900;
}
.zhuohao-popup__btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #ff9900;
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
}